// Managed by Ansible (roles/headscale). Do not edit on the server.
// Anything not written here is denied.
{
  "tagOwners": {
    "tag:infra": ["{{ headscale_user }}@"],
  },

  "acls": [
    // Personal devices reach the server's admin ports.
    // Tagged nodes lose their user identity, so this does not match the server itself.
    {
      "action": "accept",
      "src":    ["{{ headscale_user }}@"],
      "dst":    ["tag:infra:{{ mesh_tcp_ports | join(',') }}"],
    },

    // Personal devices reach the Proxmox guests, which the server routes for.
    // The guests never join the mesh and cannot be named by a tag, so the
    // destination is the subnet itself. Without this rule headscale approves the
    // route but never hands it to a client, and every guest address times out.
    {
      "action": "accept",
      "src":    ["{{ headscale_user }}@"],
      "dst":    ["{{ pve_guest_subnet }}:*"],
    },
  ],
}
