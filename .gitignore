# Collections installed by `task ansible:deps`
.ansible/

*.retry
__pycache__/
.venv/
.vault_pass

# OpenTofu. State never lands here; it lives in R2, encrypted.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan

# Written on demand by `task tofu:kubeconfig` / `task tofu:talosconfig`, and by
# `task tofu:cilium-manifest`. All three are generated; none is a source of truth.
kubeconfig
talosconfig
cilium.yaml

# The age private key must never be in the repo. It is the one secret that
# cannot itself be stored encrypted here.
*.agekey
